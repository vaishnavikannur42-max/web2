body{
font-family:Arial,sans-serif;
background-color:#f4f4f4;
margin:0;
padding:0;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
}
.container{
background:#fff;
padding:20px;
border-radius:8px;
box-shadow:0px 0px 10px rgba(0,0,0,0.1);
width:3000px;
text-align:center;
}
h1{
color:#333;
}
h2{
color:#4CAF50;
}
.count{
font-size:2em;
color:#333;
font-weight:bold;
}